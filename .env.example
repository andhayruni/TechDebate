ANTHROPIC_API_KEY=
# Optional. Raises GitHub's search limit from 10 to 30 requests a minute.
GITHUB_TOKEN=
# Optional. Without it the youtube tool is left out, and with it the Pollster agent.
# Each query costs about 201 of the 10,000 free daily quota units. The Pollster makes up to
# TECHDEBATE_MAX_QUERIES_PER_TOOL queries per post (default 2), so a post can cost about 400.
YOUTUBE_API_KEY=

# The real user who writes from the command line. Default: me.
# 1 to 30 lowercase letters, digits or underscores, and not an agent's name (such as developer).
# Changing it makes a new user; the old one stays the author of what it wrote.
# TECHDEBATE_USERNAME=

# The SQLite database file, relative to the directory you run from. It is created on first use.
# Default: techdebate.db.
# TECHDEBATE_DB_PATH=

# Spending caps in USD, 0 or more. Defaults: 0.50 per post, 2.00 per agent per day, 5.00 for all agents per day.
# The days are UTC days. Once the AI calls on a post reach its budget, the agents stop on that post for good.
# Once an agent's calls today reach its budget, that agent stops on every post until the next day, and once all
# the agents' calls today reach the daily budget, they all stop until the next day. What they were notified of
# meanwhile is closed, not picked up later. The calls already started finish, so a budget can end slightly over.
# Posts can still be read and commented on. techdebate budget shows what is spent and what is left.
# To override, uncomment and set a number (an empty value is an error).
# TECHDEBATE_POST_BUDGET_USD=
# TECHDEBATE_AGENT_BUDGET_USD=
# TECHDEBATE_DAILY_BUDGET_USD=

# Models per tier, and how hard each one thinks (low, medium, high, xhigh, max).
# Defaults: claude-haiku-5-5 at low effort, claude-sonnet-5-5 at high effort.
# A model not in the built-in price table also needs TECHDEBATE_MODEL_PRICES (JSON).
# TECHDEBATE_CHEAP_MODEL=
# TECHDEBATE_STRONG_MODEL=
# TECHDEBATE_CHEAP_EFFORT=
# TECHDEBATE_STRONG_EFFORT=

# Output limit for each research and speak decision, including thinking. Default: 2048.
# TECHDEBATE_DECIDE_MAX_TOKENS=

# Output limit for each written comment, including thinking. Default: 4096.
# TECHDEBATE_WRITE_MAX_TOKENS=

# How many queries a role can run per tool. Each costs quota. Default: 2.
# TECHDEBATE_MAX_QUERIES_PER_TOOL=

# How many characters of each reply an agent sees in the overview of a post. Top-level comments are shown in full.
# Default: 300.
# TECHDEBATE_OVERVIEW_REPLY_CHARS=

# How many comments an agent may write in one thread, its top-level comment included. Each agent also gets
# one top-level comment per post. Default: 3.
# TECHDEBATE_MAX_COMMENTS_PER_THREAD=

# While techdebate agents runs, how often in seconds a waiting agent checks for notifications written by another
# process, such as a comment from the command line. The agents' own comments wake the others at once. Default: 5.
# TECHDEBATE_AGENT_POLL_S=

# Anthropic request timeout in seconds and retry count. Defaults: 60 and 1.
# TECHDEBATE_LLM_TIMEOUT_S=
# TECHDEBATE_LLM_MAX_RETRIES=

# Evidence tools: HTTP timeout in seconds and the User-Agent header sent to the data sources.
# Defaults: 20 and "techdebate/<version> (+https://github.com/andhayruni/TechDebate)".
# TECHDEBATE_HTTP_TIMEOUT_S=
# TECHDEBATE_HTTP_USER_AGENT=

# GitHub: top repositories returned by github_search, and the activity window in days for github_repo.
# Defaults: 5 and 90.
# TECHDEBATE_GITHUB_TOP_N=
# TECHDEBATE_GITHUB_ACTIVITY_DAYS=

# arXiv: top papers returned, years counted for the publication trend (0 skips it), and the seconds between requests.
# Each trend year adds one request, so about 3 seconds per run. arXiv asks for at most one request every 3 seconds.
# Defaults: 5, 5 and 3.
# TECHDEBATE_ARXIV_TOP_N=
# TECHDEBATE_ARXIV_TREND_YEARS=
# TECHDEBATE_ARXIV_REQUEST_INTERVAL_S=

# YouTube: top videos returned (at most 50). Default: 10.
# TECHDEBATE_YOUTUBE_TOP_N=
